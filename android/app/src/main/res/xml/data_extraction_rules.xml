<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup on API 31+ (O5). Only the user's own data is backed up: user.db (ratings and
  undo history). Including anything excludes everything else, so catalog.db (rebuildable from
  the asset or a download) and the poster cache (cacheDir, never backed up) stay out.
  The WAL file is included so changes not yet checkpointed into user.db are not lost.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user.db" />
        <include domain="database" path="user.db-wal" />
    </device-transfer>
</data-extraction-rules>
